{
    // Zeus is a single package with a single virtual environment, so unlike
    // the Musibot monorepo there is one interpreter to point at and no
    // per-component workspace folders to keep apart.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    // Run mypy and ruff from the environment rather than the versions bundled
    // with the extensions, so that the editor reports exactly what
    // `.venv/bin/python -m mypy` and `-m ruff` report on the command line.
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "ruff.importStrategy": "fromEnvironment",

    "python.testing.pytestEnabled": true,

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },

    // `datasets`, `logs`, `models` and `out` hold generated data — pickles,
    // rendered images, training logs, model snapshots — and are large enough
    // to make a project-wide search useless if they are included.
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "datasets": true,
        "logs": true,
        "models": true,
        "out": true
    }
}
